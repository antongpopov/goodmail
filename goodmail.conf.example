# goodmail.conf — which IMAP/SMTP servers handle which e-mail domains.
# Users sign in with just their e-mail address + password; the domain picks the server.
#
# domainN   one or more domains (comma separated)
# imapN     host[:port]        default port 993 (implicit TLS); 143 = STARTTLS
# smtpN     host[:port]        optional, defaults to the imap host; 465 = TLS (default), 587 = STARTTLS
# loginN    email | local      username sent to the server: full address (default) or the part before @
# insecureN true               accept self-signed certificates
# titleN    Example Mail       app name these users see after signing in (default: title below)
# titleN.xx Beispiel-Mail      the same name in another language, xx = da, de, en, es, fr, nb, sv (falls back to titleN)

domain1=example.com
imap1=mail.example.com
smtp1=mail.example.com:587

domain2=example.org, example.net
imap2=mail.example.org
login2=local

# Domains not listed above are refused. Set to true to guess servers for any domain
# (autoconfig.<domain>, Thunderbird ISPDB, MX lookup, then imap./smtp.<domain>).
autodiscover=false

# title=goodmail
# title.de=goodmail            # per-language variants of the global title, e.g. title.da / title.de / title.fr
